# Firebase (cliente). Obtener en Firebase Console > Proyecto > Configuración > Tus apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fb-api-79e8c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL base de funciones. Producción (Cloud Functions):
# NEXT_PUBLIC_FIREBASE_FUNCTIONS_URL=https://us-central1-fb-api-79e8c.cloudfunctions.net
# Emulador local: NEXT_PUBLIC_FIREBASE_FUNCTIONS_URL=http://127.0.0.1:5001/fb-api-79e8c/us-central1
NEXT_PUBLIC_FIREBASE_FUNCTIONS_URL=https://us-central1-fb-api-79e8c.cloudfunctions.net

# Si las funciones están en Cloud Run, define cada URL (sustituye por las de tu consola):
# NEXT_PUBLIC_AGENDA_URL=https://agenda-xxxxx-uc.a.run.app
# NEXT_PUBLIC_MULTIMEDIA_URL=https://multimedia-xxxxx-uc.a.run.app
# NEXT_PUBLIC_INFORMACION_URL=https://informacion-xxxxx-uc.a.run.app
# NEXT_PUBLIC_EVENTOS_URL=https://eventos-xxxxx-uc.a.run.app
# NEXT_PUBLIC_REGISTERADMIN_URL=https://registeradmin-xxxxx-uc.a.run.app
# NEXT_PUBLIC_SESSION_URL=https://session-xxxxx-uc.a.run.app
# NEXT_PUBLIC_ORACION_URL=https://oracion-xxxxx-uc.a.run.app
# NEXT_PUBLIC_MINISTERIOS_URL=https://ministerios-xxxxx-uc.a.run.app

# Código de invitación para registro de admins (solo backend). En producción configurar
# en Firebase Console > Functions > Environment variables: ADMIN_INVITE_CODE
